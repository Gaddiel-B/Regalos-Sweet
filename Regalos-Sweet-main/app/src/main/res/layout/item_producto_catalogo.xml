<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="10dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <!-- FOTO PEQUEÑA DEL PRODUCTO -->
        <androidx.cardview.widget.CardView
            android:layout_width="64dp"
            android:layout_height="64dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/ivProductoImagen"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@android:drawable/ic_menu_gallery"
                tools:ignore="ContentDescription" />
        </androidx.cardview.widget.CardView>

        <!-- INFORMACIÓN: NOMBRE Y CATEGORÍA BASE -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/tvProductoNombre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#333333"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Pastel Súper Chocolate" />

            <TextView
                android:id="@+id/tvProductoCategoria"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#888888"
                android:textSize="12sp"
                tools:text="Pasteles Personalizados" />
        </LinearLayout>

        <!-- PRECIO ESTÁNDAR DE VENTA -->
        <TextView
            android:id="@+id/tvProductoPrecio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#8B263E"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="$350.00" />

    </LinearLayout>
</androidx.cardview.widget.CardView>