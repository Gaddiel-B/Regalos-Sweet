<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF0F5"
    android:orientation="vertical"
    tools:context=".Catalogo">

    <!-- ENCABEZADO -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvTituloCatalogo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📖 Catálogo de Productos"
            android:textColor="#8B263E"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSubtituloCatalogo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Consulta la oferta disponible en las 7 categorías."
            android:textColor="#666666"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- PESTAÑAS DE CATEGORÍAS (SCROLLABLE PARA LAS 7 CATEGORÍAS) -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayoutCategorias"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        app:tabIndicatorColor="#8B263E"
        app:tabMode="scrollable"
        app:tabSelectedTextColor="#8B263E"
        app:tabTextColor="#666666">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🍔 Comida Rápida" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🧇 Postres" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎂 Pasteles" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🥐 Desayunos" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎁 Regalos" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💐 Ramos" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🥪 Bocadillos" />

    </com.google.android.material.tabs.TabLayout>

    <!-- LISTA DE PRODUCTOS DE LA CATEGORÍA SELECCIONADA -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvProductosCatalogo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:padding="12dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:listitem="@layout/item_producto_catalogo" />

</LinearLayout>