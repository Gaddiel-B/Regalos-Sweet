<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF0F5"
    android:fillViewport="true"
    tools:context=".Pedido_Personalizado">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ENCABEZADO -->
        <TextView
            android:id="@+id/tvTituloPedidoEspecial"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💌 Pedido Especial"
            android:textColor="#8B263E"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSubtituloPedidoEspecial"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Personalización detallada para Pasteles, Desayunos, Regalos, Bocadillo y Ramos."
            android:textColor="#666666"
            android:textSize="14sp" />

        <!-- BLOQUE 1: DATOS DEL CLIENTE Y ENTREGA -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="👤 Cliente y Entrega"
                    android:textColor="#8B263E"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- Nombre del Cliente -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:hint="Nombre del Cliente">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etNombreClienteEspecial"
                        android:layout_width="match_parent"
                        android:textColor="@android:color/darker_gray"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Teléfono -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:hint="Teléfono de Contacto">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etTelefonoClienteEspecial"
                        android:textColor="@android:color/darker_gray"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="phone" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Dirección de Entrega -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:hint="Dirección de Entrega">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etDireccionEntregaEspecial"
                        android:layout_width="match_parent"
                        android:textColor="@android:color/darker_gray"
                        android:layout_height="wrap_content"
                        android:inputType="textPostalAddress" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Fecha y Hora de Entrega -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:hint="Fecha Evento/Entrega">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etFechaEntregaEspecial"
                            android:layout_width="match_parent"
                            android:textColor="@android:color/darker_gray"
                            android:layout_height="wrap_content"
                            android:focusable="false"
                            android:inputType="date" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:hint="Hora Entrega">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etHoraEntregaEspecial"
                            android:textColor="@android:color/darker_gray"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:focusable="false"
                            android:inputType="time" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- BLOQUE 2: ESPECIFICACIONES DEL PRODUCTO Y PERSONALIZACIÓN -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="🎂 Detalles de Personalización"
                    android:textColor="#8B263E"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- Categoría Especial -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Categoría del Pedido"
                    android:textColor="#555555"
                    android:textSize="12sp" />

                <Spinner
                    android:id="@+id/spCategoriaEspecial"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_card_sweet"
                    android:textColor="@android:color/black"
                    android:layout_marginBottom="8dp"
                     />

                <!-- Campos específicos de la categoría seleccionada -->
                <LinearLayout
                    android:id="@+id/layoutCamposDinamicos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone" />

                <!-- Sabor de Pan / Base -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilSaborPan"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:hint="Sabor de Pan / Base (ej: Vainilla, Chocolate, Red Velvet)"
                    android:textColor="@android:color/darker_gray">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etSaborPan"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:textColor="@android:color/darker_gray" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Relleno / Contenido -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilRelleno"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:hint="Relleno / Contenido (ej: Nutella con Fresa, Chocolates)"
                    android:textColor="@android:color/darker_gray">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etRelleno"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:textColor="@android:color/darker_gray" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Temática / Estilo / Tamaño -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilTematica"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:hint="Tema / Tamaño / Porciones (ej: 20 personas, Flores amarillas)"
                    android:textColor="@android:color/darker_gray">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etTematica"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:textColor="@android:color/darker_gray" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Mensaje Dedicatorio o Leyenda -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilMensajeDedicatoria"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:hint="Mensaje o Leyenda en Tarjeta/Pastel"
                    android:textColor="@android:color/darker_gray">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etMensajeDedicatoria"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top"
                        android:inputType="textMultiLine"
                        android:lines="2"
                        android:textColor="@android:color/darker_gray" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- SECCIÓN PARA SUBIR / VISUALIZAR FOTO DE REFERENCIA -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="Imagen de Referencia / Diseño"
                    android:textColor="#555555"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivFotoReferencia"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:background="#EEEEEE"
                        android:scaleType="centerCrop"
                        android:src="@android:drawable/ic_menu_camera" />

                    <Button
                        android:id="@+id/btnCargarFoto"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="Adjuntar Foto de Galería"
                        android:textColor="#8B263E"
                        app:strokeColor="#8B263E" />
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- BLOQUE 3: COTIZACIÓN Y PAGOS -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="💵 Cotización y Anticipo (50%)"
                    android:textColor="#8B263E"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- Precio Cotizado -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:hint="Precio Acordado / Cotizado ($)">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPrecioTotalEspecial"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Método de Pago -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Método de Pago"
                    android:textColor="#555555"
                    android:textSize="12sp" />

                <Spinner
                    android:id="@+id/spMetodoPagoEspecial"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="8dp"
                    android:background="@android:drawable/btn_dropdown" />

                <!-- Captura de Anticipo -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Anticipo Recibido ($)">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etAnticipoEspecial"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="numberDecimal" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Resumen de Saldo -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="#FFF0F5"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Saldo Restante a Cobrar:"
                            android:textColor="#8B263E"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvSaldoRestanteEspecial"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="$0.00"
                            android:textColor="#8B263E"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- BOTÓN GUARDAR PEDIDO ESPECIAL -->
        <Button
            android:id="@+id/btnGuardarPedidoEspecial"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="16dp"
            android:backgroundTint="#8B263E"
            android:text="Guardar Pedido Especial 🎨"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="10dp" />

    </LinearLayout>
</ScrollView>