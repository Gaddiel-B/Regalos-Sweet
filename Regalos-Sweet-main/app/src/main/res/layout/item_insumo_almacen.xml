<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardInsumo"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="10dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- ICONO DE TIPO (Ingrediente o Empaque) -->
        <TextView
            android:id="@+id/tvIconoTipo"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="🥚"
            android:textSize="22sp" />

        <!-- DETALLES DEL INSUMO -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/tvNombreInsumo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#333333"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Harina de Trigo preparaciones" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvTipoInsumo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#777777"
                    android:textSize="12sp"
                    tools:text="Ingrediente base" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" • Stock Mín: "
                    android:textColor="#777777"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvStockMinimo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#777777"
                    android:textSize="12sp"
                    tools:text="5.0 kg" />
            </LinearLayout>

            <!-- ETIQUETA EN ROJO PARA ALERTA DE STOCK CRÍTICO -->
            <TextView
                android:id="@+id/tvAlertaStock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="#FFEBEE"
                android:paddingStart="6dp"
                android:paddingTop="2dp"
                android:paddingEnd="6dp"
                android:paddingBottom="2dp"
                android:text="⚠️ Stock crítico / Reabastecer"
                android:textColor="#D32F2F"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="visible"
                tools:visibility="visible" />

        </LinearLayout>

        <!-- STOCK ACTUAL Y UNIDAD DE MEDIDA -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvStockActual"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#D32F2F"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="1.5" />

            <TextView
                android:id="@+id/tvUnidadMedida"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#666666"
                android:textSize="12sp"
                tools:text="kg" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>