<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.USE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.RegalosSweet"
        tools:targetApi="31">

        <receiver android:name=".NotificacionReceiver" android:exported="false"/>

        <activity
            android:name=".Detalle_Producto"
            android:exported="false" />
        <activity
            android:name=".Recetario"
            android:exported="false" />
        <activity
            android:name=".Agenda_Entregas"
            android:exported="false"
            android:label="@string/title_activity_agenda_entregas"
            android:theme="@style/Theme.RegalosSweet" />
        <activity
            android:name=".Inventario_Almacen"
            android:exported="false" />
        <activity
            android:name=".Catologo"
            android:exported="false" />
        <activity
            android:name=".Pedido_Personalizado"
            android:exported="false" />
        <activity
            android:name=".Pedido_Rapido"
            android:exported="false" />
        <activity
            android:name=".Categorias"
            android:exported="false"
            android:label="@string/title_activity_categorias"
            android:theme="@style/Theme.RegalosSweet" />
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>